# Copy to .env and fill in. Never commit .env.

# --- LLM: any OpenAI-compatible Chat Completions API (see README, "Using another model or provider") ---
# Model ids change often: the commented ones are examples, check the provider's list.
# Default: Google Gemini Flash-Lite, free tier, no credit card (why: docs/architecture.md, ADR-03).
# Get a key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=

# Mistral (free "Experiment" plan, high volume, phone verification): https://console.mistral.ai
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest

# Groq (free tier; low tokens-per-minute limit for this prompt size): https://console.groq.com/keys
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b

# OpenRouter (one key for many providers, some free models): https://openrouter.ai/keys
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=anthropic/claude-haiku-5.5

# OpenAI
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5-mini

# Anthropic (OpenAI-compatible endpoint)
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_MODEL=claude-haiku-5-5

# Ollama, local and free (any non-empty key works): https://ollama.com
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:8b
# LLM_API_KEY=ollama

# Optional: reasoning effort (low | medium | high), sent only when set.
# Not every provider accepts it.
# LLM_REASONING_EFFORT=low

# --- App ---
# "Today" for date logic (return windows, late deliveries). The dataset ends in
# March 2026; leave empty to use the real current date.
REFERENCE_DATE=2026-03-25

# Minutes of inactivity before a conversation starts over
SESSION_TTL_MINUTES=30

# Paths (relative to the project root)
DATA_DIR=data
COMPLAINTS_PATH=var/complaints.jsonl
